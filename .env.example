# Copy to .env and fill in. `docker compose up -d --build` then point your
# reverse proxy at http://127.0.0.1:8200 (container publishes on localhost).

# admin UI login
BGBOX_ADMIN_USER=admin
BGBOX_ADMIN_PASS=change-me-to-a-long-random-string
BGBOX_COOKIE_KEY=change-me-too

# LLM — OpenAI-compatible endpoint. Leave LLM_API_KEY empty to disable analysis.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
