# Copy to .env and fill in. `docker compose up -d --build` then point your
# reverse proxy at http://bugbox:8000 over the shared proxy-network, or at
# http://127.0.0.1:8200 from the host (the container publishes on loopback).

# admin UI login. Both settings are required and neither has a default:
# Compose refuses to start when one is unset, and Bugbox logs the error and
# exits at startup when one is empty. BGBOX_ADMIN_USER is the username you
# sign in with. BGBOX_ADMIN_PASS should be a long random password.
# Compose interpolates these values: wrap one containing "$" in single quotes
# or double each "$" ("$$"). Surrounding whitespace is trimmed from unquoted
# values.
BGBOX_ADMIN_USER=
BGBOX_ADMIN_PASS=
BGBOX_COOKIE_KEY=change-me-too
# Set to 1 when Bugbox is served over https (secure cookies only).
BGBOX_COOKIE_SECURE=0
# Set to 1 when TLS is terminated at the reverse proxy (adds HSTS).
BGBOX_HTTPS=0
# Optional display name for the owner (editable later on /admin/people).
BGBOX_ADMIN_NAME=
# Optional space/comma list of allowed POST origins (hosts). Empty = same-
# origin only; cross-site requests are rejected with 403 (CSRF gate).
BGBOX_ORIGINS=
# Optional rotating log file with secrets scrubbed (e.g. /data/bugbox.log).
# Only this file is scrubbed: stdout and stderr (the container log) are not.
BGBOX_LOG_FILE=
# Optional self-hosted Umami page analytics. Set both to enable; leave either
# empty (or use a non-https script URL) and analytics stays off. Enabling it
# allows the script and its beacon on public pages only, never on /admin.
BGBOX_ANALYTICS_SCRIPT=
BGBOX_ANALYTICS_ID=
# Optional. The overlay release number the landing page shows on a first
# start, before it has fetched anything from GitHub. Once a release has been
# fetched, the tag is kept in the data volume and this value is not used
# again, so it never overrides the real latest release. Leave it empty to
# show the built-in default (0.1.46).
BGBOX_OVERLAY_VERSION=

# Optional: GitHub developer sign-in (multi-tenant admins). New GitHub
# accounts start as 'pending' and only get access after you approve them on
# /admin/people. Create a GitHub OAuth App with the callback URL
# https://<your-domain>/auth/github/callback and paste the values here.
# Leave empty to keep login local-owner only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only needed if the callback URL is not auto-detected correctly.
GITHUB_REDIRECT_URI=

# LLM — OpenAI-compatible endpoint. Leave LLM_API_KEY empty to disable analysis.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
